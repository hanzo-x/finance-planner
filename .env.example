# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit file `.env`.

# --- Database (Neon PostgreSQL) ---
# DATABASE_URL : chuỗi kết nối "pooled" (có chữ -pooler) -> app dùng khi chạy
# DIRECT_URL   : chuỗi kết nối trực tiếp (không có -pooler) -> `prisma migrate` dùng
# Chạy local với PostgreSQL thường thì 2 dòng giống nhau cũng được.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Better Auth ---
# Tạo chuỗi bí mật ngẫu nhiên:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="doi-thanh-chuoi-bi-mat-dai-ngau-nhien"
# Địa chỉ gốc của website (local: http://localhost:3000, production: link Vercel)
BETTER_AUTH_URL="http://localhost:3000"

# --- Đăng nhập GitHub (tuỳ chọn, nhưng đề bài yêu cầu) ---
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#   Homepage URL:      http://localhost:3000
#   Callback URL:      http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Tài khoản demo do `npx prisma db seed` tạo (tuỳ chọn, có giá trị mặc định) ---
SEED_DEMO_EMAIL="demo@financeplanner.dev"
SEED_DEMO_PASSWORD="Demo@2026Planner"
